<%- include('../layout', { title: 'Modifier utilisateur' }) %>

<main>
  <h2>Modifier utilisateur</h2>

  <p>Connecté : <strong><%= user.username %></strong> (<%= user.email %>)</p>

  <p><a href="/app/users">Retour à la liste</a></p>

  <% if (errors) { %>
    <p style="color:red;"><%= errors %></p>
  <% } %>

  <form method="post" action="/app/users/<%= userToEdit._id %>">
    <div>
      <label for="username">Nom d'utilisateur :</label>
      <input type="text" id="username" name="username"
             value="<%= userToEdit.username %>" required>
    </div>
    <div>
      <label for="email">Email :</label>
      <input type="email" id="email" name="email"
             value="<%= userToEdit.email %>" required>
    </div>
    <div>
      <label for="password">Nouveau mot de passe (laisser vide pour ne pas changer) :</label>
      <input type="password" id="password" name="password">
    </div>
    <button type="submit">Enregistrer</button>
  </form>
</main>

</body>
</html>
