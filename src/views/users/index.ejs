<%- include('../layout', { title: 'Utilisateurs' }) %>

<main>
  <h2>Gestion des utilisateurs</h2>

  <p>Connecté : <strong><%= user.username %></strong> (<%= user.email %>)</p>

  <p>
    <a href="/dashboard">Retour au tableau de bord</a> |
    <a href="/app/users/new">Nouvel utilisateur</a>
  </p>

  <% if (!users || users.length === 0) { %>
    <p>Aucun utilisateur.</p>
  <% } else { %>
    <table border="1" cellspacing="0" cellpadding="4">
      <thead>
        <tr>
          <th>Nom d'utilisateur</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.username %></td>
            <td><%= u.email %></td>
            <td>
              <a href="/app/users/<%= u._id %>/edit">Modifier</a>
              <form action="/app/users/<%= u._id %>/delete" method="post" style="display:inline;">
                <button type="submit" onclick="return confirm('Supprimer cet utilisateur ?');">
                  Supprimer
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

</body>
</html>
